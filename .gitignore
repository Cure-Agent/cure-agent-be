# dependencies
node_modules/

# build
dist/

# env — 실제 키·시크릿은 절대 커밋하지 않는다 (.env.example만 커밋)
.env
.env.*
!.env.example

# test
coverage/

# ide/os
.DS_Store
.idea/
*.log

# 로컬 IDE MCP 연결 (개인 환경 전용 — 팀 공유 MCP 서버가 생기면 해제하고 커밋)
.mcp.json

# Codex 하네스 (loopin-be 선례와 같은 화이트리스트)
# config.toml·hooks.json에 절대경로가 박혀 있어 다른 체크아웃에서 그대로 못 쓰고,
# hooks/*.sh는 이미 커밋된 .claude/hooks/ 사본이라 공유할 새 내용이 없다.
# 프로젝트 스코프 스킬만 리포로 공유한다 (아직 없지만 생기면 자동으로 커밋 대상).
.codex/*
!.codex/skills/

# 테스트 동결 하네스 스크래치 (automation/freeze.md — /implement·/problem 공용)
.cure-implement/

# 수집한 지침 원본 PDF (docs/specs/18) — 재배포 회피: 레포엔 임베딩만, 원문은 NCKM 링크
.cure-data/

# terraform — 상태·변수 파일은 로컬/TFC 전용 (*.tfvars.example만 커밋)
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
**/.terraform/*
.terraform.*
# GCP 서비스 계정 키 방어 — terraform 아래에는 커밋할 json이 없다
terraform/**/*.json
