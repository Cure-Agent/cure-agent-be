# ─── 서버 ───────────────────────────────────────────────
PORT=3000

# ─── 데이터베이스 ───────────────────────────────────────
DATABASE_URL=postgres://cure:cure@localhost:5432/cure_agent

# ─── Redis (access 토큰 denylist §4.3, 이후 캐시 공용) ──
REDIS_URL=redis://localhost:6379

# ─── 인증 (architecture.md §4) ──────────────────────────
# 생성: openssl rand -base64 48
AUTH_JWT_SECRET=<openssl rand -base64 48 결과>
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_TTL_DAYS=14
# 쿠키: dev=false/미지정(host-only), prod=true/운영 도메인
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ─── 소셜 로그인 (docs/specs/17) ────────────────────────
# 유일한 인증 수단이다. 셋 중 최소 하나의 CLIENT_ID가 없으면 부팅이 실패한다.
#
# OAUTH_WEB_BASE_URL: 브라우저가 API에 도달하는 오리진 = 프론트엔드 오리진.
#   FE의 Next rewrites가 /api/v1/*을 BE로 프록시하므로 콜백도 이 경로로 받아야
#   발급 쿠키가 FE와 same-origin(first-party)으로 저장된다.
#   각 제공자 콘솔에 등록할 Redirect URI:
#     {OAUTH_WEB_BASE_URL}/api/v1/auth/oauth/{google|kakao|naver}/callback
OAUTH_WEB_BASE_URL=http://localhost:3001
# 신규 가입 티켓·state 수명(초)
OAUTH_TICKET_TTL_SEC=600
OAUTH_STATE_TTL_SEC=600

# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kakao Developers → 내 애플리케이션 → 앱 키 → REST API 키
# CLIENT_SECRET은 [보안] 메뉴에서 '사용함'으로 켠 경우에만 채운다(끄면 빈 값).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Naver Developers → 애플리케이션 → 내 애플리케이션 → API 설정
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── 필드 암호화 (architecture.md §4.5) ─────────────────
# 32바이트 base64 키. 생성: openssl rand -base64 32
# 키 로테이션 대비 버전 맵 형태이며, ACTIVE_VERSION 키로 신규 암호화한다.
CRYPTO_ENC_KEYS={"v1":"<openssl rand -base64 32 결과>"}
CRYPTO_ENC_ACTIVE_VERSION=v1
# HMAC blind index 키 (검색용, 32바이트 이상 base64)
CRYPTO_HMAC_INDEX_KEY=<openssl rand -base64 32 결과>

# ─── 실시간 장애 알림 (architecture.md §14, docs/specs/15, 선택) ───
# 여러 채널에 동시 발송한다(콤마 구분). 호스트로 형식을 판별:
#   hooks.slack.com → {text} / discord.com → {content} / 그 외 → 구조화 JSON
# 같은 title+detail 알림은 5분 내 1회만 나간다(장애 지속 시 알림 폭주 방지).
ALERT_WEBHOOK_URLS=
# 하위호환 — 단일 URL. ALERT_WEBHOOK_URLS와 함께 쓰면 합쳐진다(중복 제거).
ALERT_WEBHOOK_URL=

# ─── 실 LLM 프로바이더 (docs/specs/13, 전부 선택) ───────
# API 키를 넣은 프로바이더만 등록되고, 우선순위는 openai → anthropic이다.
# 키가 하나도 없으면 결정적 fake 단독으로 동작한다(로컬·CI 기본값).
# 반대로 실 프로바이더가 하나라도 등록되면 fake는 폴백에서 제외된다 —
# 전 프로바이더 실패는 fake 답변이 아니라 503(LLM_UNAVAILABLE)이어야 하기 때문이다.
OPENAI_API_KEY=
# 모델·엔드포인트는 프로바이더 문서 기준으로 갱신한다 (미지정 시 아래 기본값)
# gpt-5-mini에서 상향 — 기본 강도 TTFT가 실측 9.5~23s로 사용 불가 수준이었다.
# gpt-5.4-mini는 TTFT 중앙 0.8s이고 인용 마커 정확도·모순 근거 처리는 동률, 비용은 +28%.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 추론 강도: minimal | low | medium | high | none (미지정 시 none = 미전송, 모델 기본 강도)
# 추론 모델은 첫 토큰 전까지 응답 헤더를 보내지 않아 사고 시간이 곧 TTFT다. 느린 모델을 쓸 때만
# low 등으로 낮춘다 (gpt-5-mini 기준 9.5~23s → 5.6s, 추론 토큰 704→128).
# ⚠️ 비추론 모델(gpt-4.1-mini 등)에는 반드시 none이어야 한다 —
#    비추론 모델은 이 인자를 400(Unrecognized request argument)으로 거부한다.
OPENAI_REASONING_EFFORT=none

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 답변 최대 출력 토큰 (공통) — 추론 모델은 사고 토큰도 이 예산에서 쓴다.
# 1024에서는 기본 강도 실측이 832(추론 704 + 출력 128)로 81%까지 차 답변 잘림 위험이 있었다.
# 상한일 뿐이라 미사용분은 과금되지 않는다.
LLM_MAX_OUTPUT_TOKENS=4096

# ─── 실 임베딩 (docs/specs/14, 선택) ────────────────────
# OPENAI_API_KEY가 있으면 실 임베딩이 등록되고, 없으면 결정적 fake 단독이다.
# 모델을 바꾸면 벡터 좌표계가 달라지므로 기존 청크는 검색에서 제외된다(evidence_chunks.embedding_model)
# → 모델 변경 시 반드시 재인제스트(`pnpm ingest`)해야 하며, 그 전까지는 근거 0건(abstain)이다.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── 검색 거리 임계값 (docs/specs/28, 선택) ────────────────────
# top-1 코사인 거리가 이 값을 넘으면 기권한다(확실히 먼 질문의 선컷 — 리랭크 비용 절약).
# 기본값 0.48은 원문·축약 두 문체 합산 118문항 실측에서 정답 손실 0 + 여유 0.044인 값이다
# (docs/rag-eval/2026-08-02-*). 기권 재현은 리랭크 점수 게이트가 담당한다(docs/specs/29).
# 비우면 코드 기본값으로 떨어진다. 조정 후에는 `pnpm eval:rag`로 기권 지표를 재확인한다.
RETRIEVAL_DISTANCE_CUTOFF=

# ─── LLM 리랭크 (docs/specs/29, 선택) ────────────────────
# 검색을 K=30으로 열고 LLM이 재정렬해 상위 5개를 고른다. 실측: Recall@5 0.780→0.983,
# 거리 컷과 겹친 기권 재현 15/15. 지연 p50 +0.96s. OPENAI_API_KEY가 없으면 fake 단독이다.
# false면 §28 동작(코사인 top-5 + 거리 게이트)으로 돌아간다 — 리랭크 장애 시 즉시 끄는 스위치.
RETRIEVAL_RERANK_ENABLED=
# 후보 수(기본 30)·점수 컷(기본 6, 0~10). 점수 컷은 answerable min 8 / abstain max 4의 중앙값.
RETRIEVAL_RERANK_CANDIDATES=
RETRIEVAL_RERANK_SCORE_CUTOFF=

# ─── 지침 개정 감지 스케줄러 (docs/specs/26) ────────────────────
# 기본값은 꺼짐이다. 켜짐이 기본이면 로컬·CI가 시간에 의존하고 실수로 NCKM을 두드린다 —
# 프로덕션 compose가 명시적으로 켠다.
GUIDELINE_REVISION_SCAN_ENABLED=false
# 크론식은 **프로세스 TZ 기준**이며 배포 컨테이너에는 TZ가 없어 UTC다.
# 기본값 '0 19 * * *' = 04:00 KST — NCKM 수정은 전부 한국 업무시간대에 일어나므로
# 그날의 변경이 모두 반영된 뒤 도는 시각이다.
GUIDELINE_REVISION_SCAN_CRON=0 19 * * *
# 스캔 구간(목록 조회 + 잡 생성)만 감싸는 락의 TTL. 잡 소요와 무관하다 —
# 잡은 락이 풀린 뒤에도 계속 돌고, 동시 실행 1개는 DB partial unique index가 지킨다.
GUIDELINE_REVISION_SCAN_LOCK_TTL_MS=60000
