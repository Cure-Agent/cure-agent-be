// 단일 서버 통합 구성 (배포 계획 v2) — 수집 대상·전송처 전부 compose 내부 통신.
// v1(OCI) 대비: node-exporter 컨테이너 대신 Alloy 내장 unix exporter로 호스트 지표를 수집하고,
// remote write / loki push는 환경변수 대신 compose 서비스명으로 고정한다.

// ============================================================
// 호스트 메트릭 수집 (Alloy 내장 unix exporter — node-exporter 대체)
// 컨테이너에는 호스트 루트가 /rootfs 로 마운트된다 (compose 참조)
// ============================================================
prometheus.exporter.unix "host" {
  procfs_path = "/rootfs/proc"
  sysfs_path  = "/rootfs/sys"
  rootfs_path = "/rootfs"

  filesystem {
    // exporter 기본 제외 목록을 덮어쓰므로 기본 항목(var/lib/docker 등)을 함께 유지해야 한다 —
    // 빠뜨리면 컨테이너 오버레이 마운트가 파일시스템 지표로 새어 들어온다
    mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+|var/lib/kubelet/.+|host|etc)($|/)"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host_metrics.output
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// ============================================================
// 컨테이너 메트릭 수집 (Alloy 내장 cAdvisor)
// ============================================================
// NOTE: cAdvisor는 Docker의 classic overlay2 그래프 드라이버를 전제한다 —
// containerd 이미지 스토어(overlayfs)와 비호환. terraform cloud-init이
// daemon.json으로 overlay2를 강제한다 (containerd-snapshotter=false).
prometheus.exporter.cadvisor "default" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  storage_duration = "5m"
}

prometheus.scrape "cadvisor" {
  targets         = discovery.relabel.container_metrics.output
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// ============================================================
// 앱 메트릭 수집 (NestJS /metrics — prom-client)
// ============================================================
// 글로벌 prefix(api/v1)를 쓰는 앱 컨벤션을 따른다. 외부 노출은 nginx가 404로 막는다.
prometheus.scrape "app" {
  targets = [
    {
      __address__ = "app:3000",
      instance    = "cure-app",
      job         = "cure-app",
    },
  ]
  metrics_path    = "/api/v1/metrics"
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// ============================================================
// 데이터스토어 메트릭 수집 (postgres_exporter / redis_exporter)
// ============================================================
prometheus.scrape "datastores" {
  targets = [
    {
      __address__ = "postgres-exporter:9187",
      instance    = "cure-postgres",
      job         = "postgres",
    },
    {
      __address__ = "redis-exporter:9121",
      instance    = "cure-redis",
      job         = "redis",
    },
  ]
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// ============================================================
// instance 라벨 고정
// ============================================================
// Alloy는 exporter 타겟의 instance를 자기 hostname(=컨테이너 ID)으로 채운다.
// 배포로 alloy 컨테이너가 재생성될 때마다 instance가 바뀌어, 같은 지표의
// 시계열이 retention(15d) 동안 유령처럼 중복된다(예: Disk Usage 패널 이중 표시).
// 단일 서버 구성이므로 논리 이름으로 고정해 서버를 교체해도 시계열이 이어지게 한다.
discovery.relabel "host_metrics" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "instance"
    replacement  = "cure-gcp"
  }
}

discovery.relabel "container_metrics" {
  targets = prometheus.exporter.cadvisor.default.targets

  rule {
    target_label = "instance"
    replacement  = "cure-gcp"
  }
}

// ============================================================
// Prometheus Remote Write — compose 내부 prometheus로
// ============================================================
prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ============================================================
// Docker 컨테이너 로그 수집
// ============================================================
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "app_targets" {
  targets = discovery.docker.containers.targets

  // NestJS app 컨테이너만 분리 수집
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/cure-app"
    action        = "keep"
  }

  // Loki 탐색용 라벨
  rule {
    target_label = "log_source"
    replacement  = "nestjs"
  }

  rule {
    target_label = "service_name"
    replacement  = "cure-app"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

discovery.relabel "docker_targets" {
  targets = discovery.docker.containers.targets

  // app 제외, 나머지 Docker 로그
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/cure-app"
    action        = "drop"
  }

  // Loki 탐색용 라벨
  rule {
    target_label = "log_source"
    replacement  = "docker"
  }

  rule {
    target_label = "service_name"
    replacement  = "docker_containers"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "app" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.app_targets.output
  forward_to = [loki.write.default.receiver]
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_targets.output
  forward_to = [loki.write.default.receiver]
}

// ============================================================
// Loki 로그 전송 — compose 내부 loki로
// ============================================================
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
